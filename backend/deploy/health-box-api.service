[Unit]
Description=HealthBox isolated commerce API
Wants=network-online.target
After=network-online.target mysql.service

[Service]
Type=simple
User=healthbox
Group=healthbox
EnvironmentFile=/etc/health-box/health-box.env
WorkingDirectory=/var/lib/health-box
ExecStart=/opt/health-box/current/bin/health-box-api
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/health-box
ReadWritePaths=/var/lib/health-box
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
