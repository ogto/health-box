# Dedicated HealthBox API. Never point this at the NoTitle/Monoty cloud-api service.
# Include /api/v5 and do not include a trailing slash.
HEALTH_BOX_API_BASE_URL=https://health-box-api.example.com/api/v5
HEALTH_BOX_UPLOAD_API_BASE_URL=https://health-box-api.example.com/api/v5
HEALTH_BOX_CDN_BASE_URL=https://health-box-api.example.com
# HealthBox-only Toss Payments mode and matching widget key pair.
HEALTH_BOX_TOSS_PAYMENT_MODE=live
NEXT_PUBLIC_HEALTH_BOX_TOSS_CLIENT_KEY=live_gck_replace-me
HEALTH_BOX_TOSS_LIVE_SECRET_KEY=live_gsk_replace-me
HEALTH_BOX_TOSS_TEST_SECRET_KEY=test_gsk_replace-me
# Default is health-box. During the approved temporary bridge only, use notitle-temporary with an expiry date.
HEALTH_BOX_TOSS_CREDENTIAL_SOURCE=health-box
HEALTH_BOX_TOSS_TEMPORARY_BRIDGE_EXPIRES_AT=
HEALTH_BOX_PAYMENT_PROOF_SECRET=replace-with-an-independent-long-random-secret
# Shared only by the HealthBox Vercel server runtime and standalone Spring backend.
HEALTH_BOX_INTERNAL_API_KEY=replace-with-an-independent-long-random-internal-key
HEALTH_BOX_DELIVERY_API_KEY=pk_live_replace-me
HEALTH_BOX_DELIVERY_API_SECRET_KEY=sk_client_minimal_replace-me

# Public storefront domain routing.
STORE_ROOT_DOMAIN=everybuy.co.kr
ADMIN_HOSTNAME=admin.everybuy.co.kr

# Admin login and cookie verification.
# Use at least 12 characters for the password and 32 random characters for tokens.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_TOKEN=replace-with-a-long-random-token

# Member session cookie signing. Keep this stable across deployments.
# Use at least 32 random characters and never reuse the admin session token.
MEMBER_SESSION_SECRET=replace-with-a-long-random-secret
